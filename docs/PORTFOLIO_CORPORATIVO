<script>
var FAIXAS = [["Até 49 un.", 0], ["50 a 99 un.", 3], ["100 a 299 un.", 5], ["300 un. ou mais", 7]];
function aplicar(i){
  var d = FAIXAS[i][1];
  document.querySelectorAll('.faixa').forEach(function(b,k){
    b.classList.toggle('ativa', k === i);
  });
  document.querySelectorAll('[data-preco]').forEach(function(el){
    var base = parseFloat(el.dataset.preco);
    var fim = base * (1 - d/100);
    if(d === 0){
      el.innerHTML = fmt(base);
    } else {
      el.innerHTML = '<span class="cheio">' + fmt(base) + '</span>' + fmt(fim);
    }
  });
}
function fmt(v){ return 'R$ ' + v.toFixed(2).replace('.', ','); }
document.querySelectorAll('.faixa').forEach(function(b,k){
  b.addEventListener('click', function(){ aplicar(k); });
});
aplicar(0);
</script>
